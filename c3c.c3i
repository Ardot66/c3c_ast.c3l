struct AlignData
{
	CInt align;
	CInt pref_align;
}


struct AsmArgType
{
	bitstruct : uint128
	{
		bool is_write : 0..0;
		bool is_readwrite : 1..1;
		bool is_address : 2..2;
		AsmArgBits imm_arg_ubits : 3..18;
		AsmArgBits imm_arg_ibits : 19..34;
		AsmArgBits ireg_bits : 35..50;
		AsmArgBits float_bits : 51..66;
		AsmArgBits vec_bits : 67..82;
	}
}


struct CpuFeatures
{
	CULongLong[2] bits;
}


struct Clobbers
{
	ulong[4] mask;
}


struct ClobberList
{
	CChar[1024] string;
	CInt constraint_len;
}


struct AsmRegister
{
	CChar* name;
	AsmRegisterType type;
	AsmArgBits bits;
	CInt clobber_index;
}


struct AsmInstruction
{
	CChar* name;
	AsmArgType[6] param;
	CInt param_count;
	Clobbers mask;
}


struct PlatformTarget
{
	CChar* target_triple;
	CChar* cpu;
	CChar* features;
	CChar* dylib_suffix;
	Warnings warning;
	ArchType arch;
	OsType os;
	VendorType vendor;
	EnvironmentType environment_type;
	ObjectFormatType object_format;
	CInt alloca_address_space;
	Abi abi;
	AlignData[7] integers;
	AlignData[7] floats;
	AlignData[7] floats_pref;
	RelocModel reloc_model;
	bool use_dso_local;
	bitstruct : ushort
	{
		bool pic_required : 0..0;
		bool signed_c_char : 1..1;
		FloatABI float_abi : 2..4;
		CInt default_number_regs_x86 : 5..12;
		bool use_comdat : 13..13;
		bool noredzone : 14..14;
	}
	union
	{
		struct x86
		{
			bitstruct : char
			{
				bool return_small_struct_in_reg_abi : 0..0;
				bool use_soft_float : 1..1;
				bool is_mcu_api : 2..2;
			}
		}

		struct x64
		{
			CpuFeatures features;
			bitstruct : uint
			{
				CInt align_simd_default : 0..15;
				bool win64_simd_as_array : 16..16;
				bool soft_float : 17..17;
				bool is_win64 : 18..18;
				bool is_mingw64 : 19..19;
				bool pass_int128_vector_in_mem : 20..20;
			}
			CInt native_vector_size_avx;
		}

		struct mips
		{
			bitstruct : char
			{
				bool is_32_bit : 0..0;
			}
		}

		struct aarch64
		{
			bitstruct : char
			{
				bool is_aapcs : 0..0;
				bool is_darwin_pcs : 1..1;
			}
		}

		struct arm
		{
			bitstruct : char
			{
				bool is_win32 : 0..0;
				ARMVariant variant : 1..3;
				ARMABIVariant abi_variant : 4..6;
			}
		}

		struct ppc
		{
			bitstruct : char
			{
				bool is_softfp : 0..0;
			}
		}

		struct ppc64
		{
			bitstruct : char
			{
				bool is_softfp : 0..0;
				bool is_elfv2 : 1..1;
				bool has_qpx : 2..2;
			}
		}

		struct riscv
		{
			CInt xlen;
			CInt flen;
		}

		struct systemz
		{
			bitstruct : char
			{
				bool has_vector : 0..0;
			}
		}
	}
	bool big_endian;
	bool emulated_tls;
	bool tls_supported;
	bool asm_supported;
	bool float128_field;
	bool float16_field;
	bool vec128i;
	bool vec64i;
	bool vec128f;
	bool vec64f;
	bool int128_field;
	AlignData align_pointer;
	CInt align_max_vector;
	CInt align_max_tls;
	CInt align_large_array;
	CInt width_pointer;
	CInt width_register;
	CInt width_c_short;
	CInt width_c_int;
	CInt width_c_long;
	CInt width_c_long_long;
	CInt width_c_long_double;
	CInt width_c_wchar;
	CInt width_c_wint;
	CInt width_large_array_min;
	CInt reg_param_max;
	CInt sse_reg_param_max;
	CInt builtin_ms_valist;
	CInt aarch64sve_types;
	CChar* platform_name;
	bool asm_initialized;
	CChar** clobber_name_list;
	CChar* extra_clobbers;
	AsmRegister[4096] registers;
	AsmInstruction[4096] instructions;
	CInt register_count;
}

