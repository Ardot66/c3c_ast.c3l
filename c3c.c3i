struct TokenData
{
	CChar* lex_start;
	usz lex_len;
	union
	{
		struct
		{
			CChar* string;
			usz strlen;
		}

		struct
		{
			Float value;
		}

		struct
		{
			bitstruct : ulong
			{
				ulong is_base64 : 0..0;
				ulong bytes_len : 1..63;
			}
		}

		struct
		{
			Int128 char_value;
			CChar width;
		}
	}
}


struct Lexer
{
	ParseContext* context;
	CChar* file_begin;
