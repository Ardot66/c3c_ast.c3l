	uint current_row;
	uint start_row;
	CChar* line_start;
	CChar* start_row_start;
	File* file;
	TokenData data;
	SourceLoc tok_span;
	TokenType token_type;
	LexMode mode;
}


struct CompilationUnit
{
	Module* module_field;
