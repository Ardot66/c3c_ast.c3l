}


struct AstContinueBreakStmt
{
	bitstruct : char
	{
		bool is_label : 0..0;
		bool is_resolved : 1..1;
	}
	AstId defers;
	union
	{
		Label label;
		AstId ast;
	}
}


struct AstNextcaseStmt
{
	AstId defer_id;
	bool is_resolved;
	bool is_default;
	bool is_expr;
	union
	{
		struct
		{
			Label label;
			ExprId expr;
		}

		struct
		{
			AstId switch_stmt;
			union
			{
				CInt case_number;
				Expr* nextcase_value;
			}
		}
	}
}


