	Expr* return_expr;
	bool is_temp;
	Decl* generic_infer;
	Decl* generic_instance;
}

constdef AbiSpecType : CUInt
{
	ABI_TYPE_INT_24         = 1,
	ABI_TYPE_INT_40         = 3,
	ABI_TYPE_INT_48         = 5,
	ABI_TYPE_INT_56         = 7,
	ABI_TYPE_INT_VEC_2      = 9,
	ABI_TYPE_INT_VEC_4      = 11,
	ABI_TYPE_FLOAT_VEC_2    = 13,
	ABI_TYPE_FLOAT_VEC_4    = 15,
	ABI_TYPE_LONG_VEC_2     = 17,
	ABI_TYPE_FLOAT16_VEC_2  = 19,
	ABI_TYPE_FLOAT16_VEC_4  = 21,
	ABI_TYPE_BFLOAT16_VEC_2 = 23,
	ABI_TYPE_BFLOAT16_VEC_4 = 25,
	ABI_TYPE_DOUBLE_VEC_2   = 27,
	ABI_TYPE_DOUBLE_VEC_4   = 29,
	ABI_TYPE_DOUBLE_VEC_8   = 31
}


struct AbiType
{
	union
	{
		Type* type;
		AbiSpecType abi_type;
	}
}


struct ABIArgInfo
{
	bitstruct : ulong
	{
		ArrayIndex param_index_start : 0..15;
		ArrayIndex param_index_end : 16..31;
		ABIKind kind : 32..37;
	}

	struct attributes
	{
		bitstruct : ushort
		{
			bool by_reg : 0..0;
			bool zeroext : 1..1;
			bool signext : 2..2;
			bool realign : 3..3;
			bool by_val : 4..4;
			char stack_align : 5..9;
		}
	}
	union
	{
		struct direct_pair
		{
			AbiType lo;
			AbiType hi;
		}

		struct coerce_expand
		{
			char offset_hi;
			bool packed;
			Type* lo;
			Type* hi;
		}
		AbiType direct_coerce_type;
		char direct_struct_expand;

		struct indirect
		{
			AlignSize alignment;
			Type* type;
		}
	}
	Type* original_type;
	ParamRewrite rewrite;
}


struct ParamInfo
{
	Type* type;
	ParamRewrite rewrite;
}


struct FunctionPrototype
{
	CUShort vararg_index;
	bitstruct : char
	{
		CallABI call_abi : 0..3;
		bool raw_variadic : 4..4;
		bool use_win64 : 5..5;
		bool is_resolved : 6..6;
	}
	bitstruct : uint
	{
		RetValType ret_rewrite : 7..14;
		ParamRewrite return_rewrite : 15..17;
	}
	ParamInfo return_info;
	Type* return_result;
	CInt param_count;
	CUShort param_vacount;
	ABIArgInfo* ret_abi_info;
	ABIArgInfo** abi_args;
	ABIArgInfo** abi_varargs;
	Type* raw_type;
}


