	{
		bool is_volatile : 0..0;
		bool is_inline : 1..1;
		bool is_goto : 2..2;
		bool is_string : 3..3;
		bool is_aligned : 4..4;
	}
	union
	{
		AsmInlineBlock* block;
		ExprId asm_string;
	}
