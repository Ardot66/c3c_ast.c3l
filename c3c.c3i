module ardot::c3c::ast;


struct StringSlice
{
	CChar* ptr;
	usz len;
}


struct Version
{
	CInt major;
	CInt minor;
}


struct DarwinSDK
{
	Version deploy_target;
	Version min_deploy_target;
}


struct WindowsSDK
{
	CChar* windows_sdk_path;
	CChar* vs_library_path;
	CChar* cl_path;
	CChar* cl_include_env;
}


struct ScratchBuf
{
	CChar[4194304] str;
	CInt len;
}

alias UnnamedPFN1 @private = fn bool(void* arg);


struct Task
{
	UnnamedPFN1 task;
	void* arg;
}


struct VHeader
{
	CInt size;
	CInt capacity;
	CChar* data;
}

