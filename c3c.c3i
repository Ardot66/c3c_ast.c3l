}


struct CallEnv
{
	bitstruct : ushort
	{
		CallEnvKind kind : 0..7;
		bool ensures : 8..8;
		bool pure : 9..9;
		bool in_no_eval : 10..10;
		bool is_naked_fn : 11..11;
		bool ignore_deprecation : 12..12;
